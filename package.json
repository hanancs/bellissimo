{
    "name": "bellissimo",
    "displayName": "Bellissimo",
    "description": "A sophisticated and elegant dark theme for VS Code with carefully selected colors for high readability and style.",
    "version": "1.0.6",
    "publisher": "benhanansubendran",
    "icon": "images/logo.png",
    "galleryBanner": {
        "color": "#171c28",
        "theme": "dark"
    },
    "author": {
        "name": "Ben Hanan Subendran",
        "email": "benhanan.subendran@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/hanancs/bellissimo"
    },
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "bellissimo",
        "dark",
        "elegant",
        "vibrant",
        "high contrast",
        "midnight",
        "light",
        "color-theme"
    ],
    "contributes": {
        "themes": [
            {
                "label": "Bellissimo",
                "uiTheme": "vs-dark",
                "path": "./themes/bellissimo-color-theme.json"
            },
            {
                "label": "Bellissimo Midnight",
                "uiTheme": "vs-dark",
                "path": "./themes/bellissimo-midnight-color-theme.json"
            },
            {
                "label": "Bellissimo Light",
                "uiTheme": "vs",
                "path": "./themes/bellissimo-light-color-theme.json"
            }
        ],
        "iconThemes": [
            {
                "id": "bellissimo-icons",
                "label": "Bellissimo Icons",
                "path": "./bellissimo-icon-theme.json"
            }
        ],
        "walkthroughs": [
            {
                "id": "bellissimo-welcome",
                "title": "Welcome to Bellissimo",
                "description": "Get started with your new sophisticated theme collection.",
                "steps": [
                    {
                        "id": "select-theme",
                        "title": "Choose your Style",
                        "description": "Bellissimo comes with three distinct variants. Pick the one that fits your environment best.\n[Select Theme](command:workbench.action.selectTheme)",
                        "media": {
                            "svg": "images/walkthrough-variants.svg",
                            "altText": "Bellissimo Theme Variants"
                        }
                    },
                    {
                        "id": "select-icons",
                        "title": "Complete the Look",
                        "description": "Don't forget to enable the matching Bellissimo Icon Theme for a cohesive experience.\n[Select Icon Theme](command:workbench.action.selectIconTheme)",
                        "media": {
                            "svg": "icons/folder.svg",
                            "altText": "Bellissimo Icons"
                        }
                    },
                    {
                        "id": "enjoy",
                        "title": "You're all set!",
                        "description": "Thank you for installing Bellissimo. We hope you enjoy your new coding environment.\n[Join the community](https://github.com/hanancs/bellissimo)",
                        "media": {
                            "svg": "images/walkthrough-done.svg",
                            "altText": "Finished setup"
                        }
                    }
                ]
            }
        ]
    }
}