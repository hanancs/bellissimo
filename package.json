{
    "name": "bellissimo",
    "displayName": "Bellissimo",
    "description": "A sophisticated and elegant dark theme for VS Code with carefully selected colors for high readability and style.",
    "version": "1.0.2",
    "publisher": "benhanansubendran",
    "icon": "images/logo.png",
    "galleryBanner": {
        "color": "#171c28",
        "theme": "dark"
    },
    "author": {
        "name": "Ben Hanan Subendran",
        "email": "benhanan.subendran@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/hanancs/bellissimo"
    },
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "bellissimo",
        "dark",
        "elegant",
        "vibrant",
        "high contrast",
        "midnight",
        "light",
        "color-theme"
    ],
    "contributes": {
        "themes": [
            {
                "label": "Bellissimo",
                "uiTheme": "vs-dark",
                "path": "./themes/bellissimo-color-theme.json"
            },
            {
                "label": "Bellissimo Midnight",
                "uiTheme": "vs-dark",
                "path": "./themes/bellissimo-midnight-color-theme.json"
            },
            {
                "label": "Bellissimo Light",
                "uiTheme": "vs",
                "path": "./themes/bellissimo-light-color-theme.json"
            }
        ],
        "iconThemes": [
            {
                "id": "bellissimo-icons",
                "label": "Bellissimo Icons",
                "path": "./bellissimo-icon-theme.json"
            }
        ]
    }
}